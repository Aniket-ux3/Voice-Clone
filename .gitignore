# =============================================================================
#  Synthetic Voice Studio — .gitignore
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
venv/
env/
ENV/
.venv/

# ── Type checking / testing ───────────────────────────────────────────────────
.mypy_cache/
.pytest_cache/
.tox/
htmlcov/
.coverage
.coverage.*

# ── Model weights (large — stored on HF Hub, downloaded at runtime) ───────────
checkpoints_v2/converter/checkpoint.pth

# ── Runtime temp files (auto-generated, never commit) ────────────────────────
processed/*
!processed/.gitkeep
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# ── Audio files ───────────────────────────────────────────────────────────────
*.wav
*.mp3
*.mp4
*.ogg
*.flac
*.m4a
*.aac
*.aiff
*.wma

# ── Environment variables ─────────────────────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.production

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS generated ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.vs/

# ── Temp / backup / trash files ──────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig
.trash_*

# ── Dev tooling (not needed in repo) ─────────────────────────────────────────
.mcp.json
.agent/
.packageignore
docker-compose.override.yml

# ── HF cache (auto-downloaded) ───────────────────────────────────────────────
.cache/
huggingface/

# ── Python pycache in OpenVoice subdir ───────────────────────────────────────
OpenVoice/**/__pycache__/
OpenVoice/**/*.pyc
