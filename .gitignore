# =============================================================================
#  Synthetic Voice Studio — .gitignore
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
venv/
env/
ENV/
.venv/

# ── Type checking / testing ───────────────────────────────────────────────────
.mypy_cache/
.pytest_cache/
.tox/
htmlcov/
.coverage
.coverage.*

# ── Model weights ─────────────────────────────────────────────────────────────
# Large checkpoint — NOT committed. Downloaded at container startup via
# download_models.py using the HF_CHECKPOINT_REPO environment variable.
checkpoints_v2/converter/checkpoint.pth

# Small speaker embedding .pth files (18 KB total) ARE committed so they are
# available immediately without requiring HF_CHECKPOINT_REPO to be set.
# Do NOT add checkpoints_v2/base_speakers/ to this ignore list.

# ── Runtime temp directories (auto-generated, never commit contents) ──────────
processed/*
!processed/.gitkeep
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# ── Emotion wavs (auto-generated at server startup, not committed) ────────────
emotions/*.wav

# ── Audio / media files ───────────────────────────────────────────────────────
*.mp3
*.mp4
*.ogg
*.flac
*.m4a
*.aac
*.aiff
*.wma
# Note: *.wav is intentionally NOT ignored globally — the .pth and source SE
# files are not wav. Wav files in uploads/outputs/emotions are covered above.

# ── Environment variables ─────────────────────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.production
# .env.example IS committed — it documents required variables without secrets

# ── Node / Frontend build ─────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS generated ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.vs/

# ── Dev tooling — local only, not relevant to collaborators or deployment ─────
# Claude MCP configuration (machine-specific)
.mcp.json
# Claude agent skills (IDE plugin artifacts)
.agent/
# Docker compose local overrides
docker-compose.override.yml

# ── Trash / backup files (prefixed to mark for deletion) ─────────────────────
.trash_*
*.bak
*.orig
*.tmp
tmp/
temp/

# ── Superseded files (kept locally for reference, not part of the codebase) ───
# se_extractor.py is now the canonical file at OpenVoice/openvoice/se_extractor.py
se_extractor_patched.py

# ── OpenVoice subdir artifacts ────────────────────────────────────────────────
OpenVoice/**/__pycache__/
OpenVoice/**/*.pyc
OpenVoice/**/*.egg-info/
# OpenVoice has its own .git — exclude it so our repo doesn't treat it as
# a submodule (we vendor the source directly and patch se_extractor.py)
OpenVoice/.git/
OpenVoice/.gitignore

# ── HF / torch cache (auto-downloaded at runtime) ────────────────────────────
.cache/
huggingface/
