# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Audio files (don't commit generated audio)
*.wav
*.mp3
*.ogg
*.flac

# Uploads and outputs
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep
processed/*
!processed/.gitkeep

# Environment variables
.env
.env.local
.env.*.local

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# Docker
.dockerignore

# Node (if frontend has node modules)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
Thumbs.db
.DS_Store

# Temporary files
tmp/
temp/
*.tmp

# Model checkpoints (optional - if too large for git)
# Uncomment if checkpoints are very large (>100MB)
# checkpoints_v2/*
# !checkpoints_v2/.gitkeep
