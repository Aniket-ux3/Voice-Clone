# =============================================================================
#  .dockerignore — minimize Docker build context sent to HF Spaces builder.
#  Large files here = slow "building" phase with no visible progress.
# =============================================================================

# Git
.git
.gitignore

# Python environments & caches
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/

# Node / Frontend (built separately, served via Vercel)
frontend/
node_modules/

# Large model checkpoints (downloaded at runtime from HF Hub)
checkpoints_v2/

# OpenVoice (cloned inside container via Dockerfile)
OpenVoice/

# Runtime temp folders
uploads/
outputs/
processed/

# Emotion audio samples
emotions/

# Audio / media
*.wav
*.mp3
*.mp4
*.ogg
*.flac
*.m4a
*.aac

# Logs
*.log
logs/

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets
.env
.env.*
.mcp.json

# Dev tooling / docs
.mcp.json
.agent/
.packageignore
docker-compose.override.yml
cleanup.bat
DEPLOYMENT_GUIDE.md
SETUP_GUIDE.md
PROJECT_CONTEXT.md
