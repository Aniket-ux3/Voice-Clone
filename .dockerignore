# =============================================================================
#  .dockerignore — minimises the Docker build context sent to HF Spaces.
#  Only files actually needed inside the container are allowed through.
#  Everything else adds build time with no benefit.
# =============================================================================

# ── Git metadata ──────────────────────────────────────────────────────────────
.git/
.gitignore

# ── Python local environment (container installs its own) ────────────────────
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/

# ── Node / Frontend (served via Vercel, not needed in backend container) ──────
frontend/
node_modules/

# ── OpenVoice source (cloned fresh inside the Dockerfile via git clone) ───────
# The Dockerfile clones OpenVoice and then overwrites se_extractor.py with
# the patched version from OpenVoice/openvoice/se_extractor.py below.
# Excluding the whole tree keeps the build context small.
OpenVoice/

# ── Large model checkpoints (downloaded at runtime from HF Hub) ───────────────
checkpoints_v2/converter/checkpoint.pth

# ── Runtime temp folders (created empty by the Dockerfile) ───────────────────
uploads/
outputs/
processed/

# ── Emotion wavs (regenerated at server boot by _generate_emotion_wavs) ───────
emotions/*.wav

# ── Audio / media ─────────────────────────────────────────────────────────────
*.mp3
*.mp4
*.ogg
*.flac
*.m4a
*.aac

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS / Editor artifacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Secrets (never in container image) ───────────────────────────────────────
.env
.env.*
.mcp.json

# ── Dev-only tooling (not needed in production container) ────────────────────
.agent/
.trash_*
cleanup_cache.bat
se_extractor_patched.py
docker-compose.override.yml
